    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
