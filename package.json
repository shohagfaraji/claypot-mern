{
  "name": "claypot-mern",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack recipe-sharing platform built with the MERN stack.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently --names client,server --prefix-colors cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace @claypot/client",
    "dev:server": "npm run dev --workspace @claypot/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "3.6.2"
  }
}
