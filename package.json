{
  "name": "claypot-mern",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack recipe-sharing platform built with the MERN stack.",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:client": "npm run dev --workspace @claypot/client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
